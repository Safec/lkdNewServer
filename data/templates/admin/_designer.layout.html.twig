{% extends 'admin/_layout.html.twig' %}

{% block main %}
    <main class="main profile-page__main">
        <div class="container">

            {% block header %}
                <div class="main-header main__header">
                    {% include 'admin/_header.html.twig' with {'class': 'main-header__profile'} %}
                    {% block header_action %}{% endblock %}
                </div>
            {% endblock %}

            {% block main_content %}
                <div class="main__content">
                    {% include 'admin/_designer.submenu.html.twig' with {'designer': designer|default} %}
                    {% block content %}{% endblock %}
                </div>
            {% endblock %}

        </div>
    </main>
{% endblock %}
