{% extends 'admin/_layout.html.twig' %}

{% block main %}
    <main class="main profile-page__main">
        <div class="container">
            {% block header %}
                <div class="main-header main__header">
                    {% include 'admin/_header.html.twig' with {'class': 'main-header__profile'} %}
                    {% block header_action %}{% endblock %}
                </div>
            {% endblock %}

            <div class="main__content">

                {% if manager is defined and manager.id %}
                    {% set submenu = [
                        {
                            'title': 'Профиль',
                            'path': path('admin.manager.edit', {'id': manager.id}),
                            'icon': 'face',
                            'disabled': false,
                        }
                    ] %}

                    <div class="submenu__container">
                        <ul class="submenu">
                            {% for menu_item in submenu %}
                                <li class="submenu__item">
                                    <a class="submenu__item__link {% if menu_item.disabled|default(false) %}disabled{% endif %} {% if app.request.pathinfo starts with menu_item.path %}active{% endif %}"
                                       href="{{ menu_item.path }}"
                                    >
                                        <div class="mask-icon mask-icon--{{ menu_item.icon }} submenu__item__link__icon"></div>
                                        <p class="submenu__item__link__text">{{ menu_item.title }}</p>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>

                        <div class="submenu__profile">
                            {% if manager.profile.avatar %}
                                <img class="submenu__profile__avatar" alt="" src="{{ asset(parameters.images.path|trim('/') ~ '/' ~ manager.profile.avatar|trim('/')) }}">
                            {% else %}
                                <img class="submenu__profile__avatar" alt="" src="{{ asset('build/images/missing-image--small.svg') }}">
                            {% endif %}
                            <div class="submenu__profile__text">
                                <p class="submenu__profile__text__name">{{ manager.profile.fullName }}</p>
                                <p class="submenu__profile__text__profession">{{ manager.profile.position }}</p>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% block content %}{% endblock %}
            </div>

        </div>
    </main>
{% endblock %}
