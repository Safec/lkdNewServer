{% extends 'admin/_designer.layout.html.twig' %}

{% block content %}

    {% if drafts|default %}

        <div class="portfolio main__content">
            <div class="projects-list portfolio__projects">

                {% for draft in drafts %}
                    <a href="{{ path('admin.designer.draft.view', {'id': draft.id, 'designerId': draft.author.id}) }}" class="projects-item">
                        {% if draft.images %}
                            {% if draft.cover and draft.cover in draft.images %}
                                <img class="projects-item__preview" src="{{ asset(parameters.images.path|trim('/') ~ '/' ~ draft.cover ~ '?h=1024') }}" alt="">
                            {% else %}
                                <img class="projects-item__preview" src="{{ asset(parameters.images.path|trim('/') ~ '/' ~ draft.images|first ~ '?h=1024') }}" alt="">
                            {% endif %}
                        {% else %}
                            <img class="projects-item__preview" src="{{ asset('build/images/missing-image.svg') }}" alt="">
                        {% endif %}
                        <div class="projects-item__about">
                            <p class="h3 projects-item__name">{{ draft.title }}</p>
                            <p class="projects-item__specs">{{ draft.subtitle }}</p>
                        </div>
                    </a>
                {% endfor %}

            </div>
        </div>

    {% else %}

        <div class="main__placeholder">
            <div class="main-placeholder">
                <div class="mask-icon mask-icon--design main-placeholder__icon"></div>
                <p>У дизайнера пока нет черновиков.</p>
            </div>
        </div>

    {% endif %}

{% endblock %}
