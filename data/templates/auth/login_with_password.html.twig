{% extends 'auth/_layout.html.twig' %}

{% block content %}
    <h4>Войдите</h4>

    {% set errors = app.flashes('error') %}
    {% set successes = app.flashes('success') %}

    <form id="auth" action="{{ path('auth.auth') }}" method="post" class="symfony-form mt-5">
        <input type="hidden" name="{{ options.csrf_parameter|default('_csrf_token') }}"
               value="{{ csrf_token(options.csrf_token_id|default('authenticate')) }}"
        >

        {% if use_captcha|default(false) and h_captcha.enabled|default(false) %}
            <div class="mb-4">
                <div id="h-captcha"></div>
                <!--suppress JSUnresolvedReference -->
                <script type="text/javascript">
                    function h_captcha_onload() {
                        const covered = document.querySelectorAll(".captcha-cloak");
                        covered.forEach(el => el.classList.add("hidden"));

                        hcaptcha.render("h-captcha", {
                            "sitekey": {{ h_captcha.sitekey|json_encode|raw }},
                            "callback": function () {
                                covered.forEach(el => el.classList.remove("hidden"));
                            }
                        });
                    }
                </script>
                <script src="https://js.hcaptcha.com/1/api.js?recaptchacompat=off&onload=h_captcha_onload" async defer></script>
            </div>
        {% else %}
            <input type="hidden" name="{{ options.captcha_csrf_parameter|default('_captcha_csrf_token') }}"
                   value="{{ csrf_token(options.captcha_csrf_token_id|default('_captcha')) }}"/>
        {% endif %}

        <div class="captcha-cloak">
            <div class="mb-4">
                <label for="_username">Логин</label>
                <input id="_username" name="{{ options.username_parameter|default('_username') }}"
                       value="{{ last_username|default }}" type="text" placeholder="Введите свой логин"
                       title="Логин, эл. почта или телефон" required autocomplete="username"
                       class="w-full {% if errors|default %}is-invalid{% endif %}"
                />
            </div>

            <div class="mb-4">
                <div class="captcha-cloak">
                    <label for="_password">Пароль</label>
                    <div class="relative">
                        <div>
                            <input id="_password" name="{{ options.password_parameter|default('_password') }}"
                                   value="" type="password" placeholder="Пароль" title="Пароль" autocomplete="current-password"
                                   required class="w-full {% if errors|default %}!border-rose{% endif %}"
                            />
                        </div>
                        <img class="absolute right-3 top-1/2 transform -translate-y-1/2 cursor-pointer hover:opacity-60"
                             onclick="const input = this.parentNode.querySelector('input'); input.type = input.type === 'password' ? 'text' : 'password'; input.focus();"
                             src="data:image/svg+xml;base64,"
                             alt=""
                        />
                    </div>
                </div>

                {% for error in errors|default([]) %}
                    <div class="error mt-1 text-xs text-rose">{{ error|trans }}</div>
                {% endfor %}

                {% for success in successes|default([]) %}
                    <div class="success mt-1 text-xs text-primary">{{ success|trans }}</div>
                {% endfor %}
            </div>

            <button type="submit" class="w-full mt-2 captcha-cloak" data-form-required>Войти</button>
        </div>
    </form>
{% endblock %}