{% extends 'designer/_layout.html.twig' %}

{% set active_link = 'cont_sale' %}

{% block content %}
<div class="requests__content __content">
    {% include 'designer/_contacts_menu.html.twig' with {'active_link': active_link} %}
    <div class="requests__content__right-column">
        <div class="question__question-item__request" id="cont_sale">
            <div class="project-edit main__content main__content--pad requests-block">
                <div class="arrow_mobile">
                    <a href="{{ path('designer.discount_request') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="24" height="24">
                            <path d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.2 288 416 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-306.7 0L214.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"/>
                        </svg>
                    </a>
                </div>
                <h4 class="mt-5" style="font-weight: normal;">Запрос отправлен</h4>
                <div class="mt-5">
                    В течение 2х рабочих дней мы направим вам уникальный промокод на 1 использование, который вы сможете передать клиенту.
                </div>
                <div class="mt-5"><b>Правила использования промокода:</b></div>
                <div class="mt-5">
                    <div>1. Промокод уникальный и не может быть передан другому клиенту</div>
                    <div>2. Скидка не суммируется со скидкой по промокоду клиента</div>
                    <div>3. Скидка не распространяется на услуги (сборка, доставка, пр.) и уцененный товар</div>
                </div>
                <div class="mt-5">
                    <a class="button--primary button" href="{{ path('designer.discount_request') }}">Заполнить новый запрос</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}