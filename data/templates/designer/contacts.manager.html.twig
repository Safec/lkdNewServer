{% block content %}
    <div class="main__content">

        <div class="contacts">

            {% for manager in managers|default %}
                {% if manager.profile.fullName|default %}
                    <div class="contacts__contact">
                        <div class="contacts__contact__avatar">
                            {% if manager.profile.avatar|default %}
                                <img src="{{ asset(parameters.images.path|trim('/') ~ '/' ~ manager.profile.avatar|trim('/') ~ '?w=160&h=160&fit=crop') }}" alt="">
                            {% else %}
                                <img src="{{ asset('/build/images/missing-image--small.svg') }}" alt="">
                            {% endif %}
                        </div>
                        <div class="contacts__contact__name">{{ manager.profile.fullName|default }}</div>
                        <div class="contacts__contact__position">{{ manager.profile.position|default(manager.profile.profession|default) }}</div>
                        <div class="contacts__contact__wrap">
                            {% if manager.profile.phone|default %}
                                <div class="contacts__contact__wrap__phone">
                                    <i class="mask-icon mask-icon--phone"></i>
                                    <a href="tel:{{ manager.profile.phone }}">{{ manager.profile.phone|phone }}</a>
                                </div>
                            {% endif %}
                            {% if manager.profile.email|default %}
                                <div class="contacts__contact__wrap__email">
                                    <i class="mask-icon mask-icon--mail"></i>
                                    <a href="mailto:{{ manager.profile.email }}">{{ manager.profile.email }}</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

        </div>

    </div>
{% endblock %}