{% extends 'designer/_layout.html.twig' %}

{% block header_action %}
    <a href="{{ path('auth.logout') }}" class="main-header__action button button--additional desktop:hidden">
        <i class="mask-icon mask-icon--small mask-icon--exit mr-2"></i>
        Выйти
    </a>
{% endblock %}

{% block content %}

    {{ form_start(form, {'attr': {'data-js-validate': ''}}) }}

    <div class="profile__content profile-page__content main__content">

        <div class="profile__content__left-column">
            {% include '_common/_profile_avatar_uploader.html.twig' with {'form': form} %}
        </div>

        <div class="profile__content__right-column">
            {% if not has_requisites|default %}
                <div class="tooltip tooltip--warning">
                    <div class="text-sm">Для перехода на следующий шаг, заполните все обязательные поля.</div>
                </div>
            {% endif %}

            <div class="profile__form">

                <div>{{ form_errors(form) }}</div>

                <div class="profile__form__section">
                    <h4>Личные данные</h4>
                    <div>
                        {{ form_row(form.fullName) }}
                    </div>
                    <div class="form-row">
                        {{ form_row(form.phone) }}
                        {{ form_row(form.email) }}
                    </div>
                    <div class="form-row">
                        {{ form_row(form.city) }}
                        {{ form_row(form.legalEntity) }}
                    </div>
                    <div class="form-row">
                        {{ form_row(form.telegram) }}
                        <div class="mb-5"></div>
                    </div>
                </div>

                <div class="profile__form__section">
                    <h4>Контакты</h4>
                    <div class="form-row">
                        <div data-index="{{ form.sites|length > 0 ? form.sites|last.vars.name + 1 : 0 }}"
                             data-prototype="{{ form_widget(form.sites.vars.prototype)|e('html_attr') }}"
                             class="mb-5"
                        >
                            {{ form_label(form.sites) }}
                            {{ form_errors(form.sites) }}

                            <div class="sites">
                                {{ form_widget(form.sites) }}
                            </div>

                            <button type="button" class="button button--outline button--compact w-full !mt-0"
                                    onclick="App.UI.Form.addFormToCollection(this.parentNode, this.parentNode.querySelector('.sites'))">
                                <i class="mask-icon mask-icon--add mr-2"></i>
                                Добавить ссылку
                            </button>
                        </div>

                        <div data-index="{{ form.socialMedias|length > 0 ? form.socialMedias|last.vars.name + 1 : 0 }}"
                             data-prototype="{{ form_widget(form.socialMedias.vars.prototype)|e('html_attr') }}"
                             class="mb-5"
                        >
                            {{ form_label(form.socialMedias) }}
                            {{ form_errors(form.socialMedias) }}

                            <div class="social-medias">
                                {{ form_widget(form.socialMedias) }}
                            </div>

                            <button type="button" class="button button--outline button--compact w-full !mt-0"
                                    onclick="App.UI.Form.addFormToCollection(this.parentNode, this.parentNode.querySelector('.social-medias'))">
                                <i class="mask-icon mask-icon--add mr-2"></i>
                                Добавить ссылку
                            </button>
                        </div>
                    </div>
                </div>

                <div class="profile__form__section">
                    {% if form.userAgreementAccepted is defined %}
                        <div>
                            {{ form_widget(form.userAgreementAccepted) }}
                            <label for="profile_userAgreementAccepted">
                                Я согласен с <a href="{{ asset('/terms_of_use.pdf') }}" target="_blank" class="text-primary hover:text-primary-hover">
                                    пользовательским соглашением</a> и подтверждаю ознакомление с <a class="text-primary hover:text-primary-hover" href="https://www.askona.ru/pokupatelyam/policy/" target="_blank">Политикой обработки персональных данных</a>
                            </label>
                        </div>
                    {% endif %}
                    {% if form.userAgreementAcceptedReklama is defined %}
                        <div>
                            {{ form_widget(form.userAgreementAcceptedReklama) }}
                            <label for="profile_userAgreementAcceptedReklama">
                                Согласен(-на) на коммуникации и получение рекламных материалов на указанный e-mail, номер телефона и обработку данных в указанных целях в соответствии с
                                <a href="{{ asset('/sogl_of_user.pdf') }}" target="_blank" class="text-primary hover:text-primary-hover">условиями согласия</a>. Подробнее в <a class="text-primary hover:text-primary-hover" href="https://www.askona.ru/pokupatelyam/policy/" target="_blank">Политике обработки персональных данных</a>
                            </label>
                        </div>
                    {% endif %}

                    {% if has_requisites|default %}
                        {{ form_row(form.save, {'label': 'form.save.label', 'attr': {'data-form-required': ''}}) }}
                    {% else %}
                        {{ form_row(form.save, {'label': 'form.save_and_continue.label', 'attr': {'data-form-required': ''}}) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {{ form_end(form) }}

{% endblock %}

