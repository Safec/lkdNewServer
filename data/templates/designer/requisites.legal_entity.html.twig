{% extends 'designer/_layout.html.twig' %}

{% block content %}

    <div class="requisites requisites__content main__content">

        <div class="requisites__header requisites__header--designer">
            <div class="position-1">
                <div class="flex flex-row gap-10 min-w-full max-w-full">
                    <div>
                        <a href="{{ path('designer.requisites.legal_entity') }}" class="requisites__header__title">1. Форма юридического лица</a>
                    </div>
                    <div>
                        <a href="{{ path('designer.requisites.personal_data') }}" class="requisites__header__title disabled">2. Личные данные</a>
                    </div>
                    <div>
                        <a href="{{ path('designer.requisites.documents_upload') }}" class="requisites__header__title disabled">3. Загрузка документов</a>
                    </div>
                </div>
            </div>
        </div>


        <div class="flex">
            {{ form_start(form) }}
            {% set contract_number = form.contractNumber.vars.value|default %}
            {% set edo_number = form.edoNumber.vars.value|default %}
            <div class="flex flex-col items-start justify-start mb-6">
                <div class="mb-4" style="display:none;">
                    <label for="has-contract-number">
                        <input id="has-contract-number" name="hasContractNumber" type="checkbox" {% if contract_number|length > 0 %}checked{% endif %}
                                onclick="document.getElementById('legal-entity').classList.toggle('!hidden'); document.getElementById('contract-number').classList.toggle('!hidden');"
                        />
                        Являюсь партнером компании
                    </label>
                </div>
                <div>
                    <div id="legal-entity" {% if contract_number|length > 0 %}class="!hidden"{% endif %}>{{ form_row(form.legalEntity) }}</div>

                    <div id="tax-system-wrapper" style="display: none;">
                        {{ form_row(form.taxSystem) }}
                    </div>

                    <div id="vat-rate-wrapper" style="display: none;">
                        {{ form_row(form.vatRate) }}
                    </div>

                    <div id="contract-number" {% if not contract_number|length > 0 %}class="!hidden"{% endif %}>{{ form_row(form.contractNumber) }}</div>
                </div>
                <div>
                    <label for="has-edo-number">
                        <input id="has-edo-number" name="hasEdoNumber" type="checkbox" {% if edo_number|length > 0 %}checked{% endif %}
                               onclick="document.getElementById('edo-number').classList.toggle('!hidden');"
                        />
                        Подключен в электронному документообороту
                    </label>
                </div>
                <div>
                    <div id="edo-number" {% if not edo_number|length > 0 %}class="!hidden"{% endif %}>{{ form_row(form.edoNumber) }}</div>
                </div>
            </div>
            {{ form_end(form) }}
        </div>

    </div>

{% endblock %}