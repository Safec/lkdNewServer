{% extends '_layout.html.twig' %}

{% block landCss %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
    <main class="askona-design">
        <div class="askona-design-intro">
            <div class="askona-design-intro-header askona-design-intro__header">
                <a href="https://www.askona.ru/">
                    <img class="askona-design-intro-header__logo" src="/build/images/logo-light.svg" alt="Askona">
                </a>
                <div class="konkurs-intro-header__contacts__icons">
                    <a href="mailto:askona_design@askona.ru" target="_blank"><img src="/build/images/landing/konkurs/icons/email.png" /></a>
                    <a href="https://t.me/AskonaDesign" target="_blank"><img src="/build/images/landing/konkurs/icons/telega.png" /></a>
                    <a href="https://max.ru/u/f9LHodD0cOKpQt8xYdtLaau3eJChFPrpDZQydIHZPa6LqwT2mr_9osOacds" target="_blank"><img src="/build/images/landing/konkurs/icons/phone.png" /></a>
                </div>
                <div class="askona-design-intro-header-contacts askona-design-intro-header__contacts">
                    <a class="askona-design-intro-header-contacts__phone" href="tel:88002004090">8 800 200-40-90</a>
                    <a
                        class="askona-design-intro-header-contacts__recall" style="cursor: pointer"
                        data-bs-toggle="modal" data-bs-target="#questionModal" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-zadat_vopros');"
                    >Задать вопрос</a>
                </div>
            </div>
            <div class="askona-design-intro__content">
                <h1 class="askona-design-intro__title">
                    Развивайтесь с&nbsp;нами на&nbsp;платформе Askona Design
                </h1>
                <p class="askona-design-intro__description">
                    Askona Design – платформа для дизайнеров и&nbsp;архитекторов помогает улучшить 
                    работу с заказчиками и&nbsp;эффективнее взаимодействовать с компанией Askona
                </p>
                <a
                    class="askona-button askona-design-intro__cooperation"
                    href="/auth/login" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-nachat_sotrudnichestvo');"
                >
                    Начать сотрудничество
                </a>
            </div>
        </div>

        <div class="askona-design-support askona-design__support">
            <div class="h1">Поддержим на всех этапах</div>
            <div class="askona-design-support-stages askona-design-support__stages">
                <div class="askona-design-card">
                    <div class="mask-icon askona-design-card__icon askona-design-card__icon--discount"></div>
                    <p class="askona-design-card__title">
                        Скидка по программе сотрудничества
                    </p>
                    <p class="askona-design-card__text">
                        Программа сотрудничества на всю сеть салонов и даже на товары по акции
                    </p>
                </div>
                <div class="askona-design-card">
                    <div class="mask-icon askona-design-card__icon askona-design-card__icon--manager"></div>
                    <p class="askona-design-card__title">
                        Персональный менеджер
                    </p>
                    <p class="askona-design-card__text">
                        Профессиональный менеджер сопровождает процесс сотрудничества (договор, закрывающие документы)
                    </p>
                </div>
                <div class="askona-design-card">
                    <div class="mask-icon askona-design-card__icon askona-design-card__icon--assortment"></div>
                    <p class="askona-design-card__title">
                        Регулярное обновление ассортимента
                    </p>
                    <p class="askona-design-card__text">
                        Мебель и аксессуары для спальни, гостиной, детской и более 1000 3D-моделей товаров
                    </p>
                </div>
                <div class="askona-design-card">
                    <div class="mask-icon askona-design-card__icon askona-design-card__icon--sales"></div>
                    <p class="askona-design-card__title">
                        Оффлайн и онлайн продажи
                    </p>
                    <p class="askona-design-card__text">
                        Удобное расположение салонов, а в гипермаркете мебели Askona Home есть практически все
                    </p>
                </div>
            </div>
            <a
                class="askona-button askona-design-support__cooperation"
                href="/auth/login" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-nachat_sotrudnichestvo');"
            >Начать сотрудничество</a>
        </div>

        <div class="askona-design-usage askona-design__usage">
            <div class="h1">Простой и понятный интерфейс</div>
            <div class="askona-design-usage__content">
                <img class="askona-design-usage__ui" src="/build/images/landing/askona_design/ui-desktop.jpg">
                <div class="askona-design-usage-about askona-design-usage__about">
                    <ol class="askona-design-usage-stages askona-design-usage-about__stages">
                        <li class="askona-design-usage-stage-wrapper askona-design-usage-stages__stage">
                            <img 
                                class="askona-design-usage-stage-wrapper__ui"
                                src="/build/images/landing/askona_design/ui-mobile-1.jpg"
                                alt=""
                            >
                            <div class="askona-design-usage-stage askona-design-usage-stage-wrapper__content">
                                <p class="askona-design-usage-stage__title">
                                    Рабочие инструменты
                                </p>
                                <ul class="askona-design-usage-stage-clauses askona-design-usage-stage__clauses">
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        База 3D-моделей Askona
                                    </li>
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        Черновик проекта
                                    </li>
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        Портфолио
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="askona-design-usage-stage-wrapper askona-design-usage-stages__stage">
                            <img
                                class="askona-design-usage-stage-wrapper__ui"
                                src="/build/images/landing/askona_design/ui-mobile-2.jpg"
                                alt=""
                            >
                            <div class="askona-design-usage-stage askona-design-usage-stage-wrapper__content">
                                <p class="askona-design-usage-stage__title">
                                    Комфортное взаимодействие
                                </p>
                                <ul class="askona-design-usage-stage-clauses askona-design-usage-stage__clauses">
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        Заключение договоров
                                    </li>
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        PR поддержка от Askona
                                    </li>
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        Связь с менеджером
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="askona-design-usage-stage-wrapper askona-design-usage-stages__stage">
                            <img
                                class="askona-design-usage-stage-wrapper__ui"
                                src="/build/images/landing/askona_design/ui-mobile-3.jpg"
                                alt=""
                            >
                            <div class="askona-design-usage-stage askona-design-usage-stage-wrapper__content">
                                <p class="askona-design-usage-stage__title">
                                    Развитие
                                </p>
                                <ul class="askona-design-usage-stage-clauses askona-design-usage-stage__clauses">
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        Дополнительный охват целевой аудитории с&nbsp;помощью статей и&nbsp;публикаций проектов
                                    </li>
                                    <li class="askona-design-usage-stage-clauses__clause">
                                        Мероприятия для партнёров
                                    </li>
                                </ul>
                            </div>
                        </li>
                    </ol>

                    <a
                        class="askona-button askona-button--secondary askona-design-usage-about__question"
                        data-bs-toggle="modal" data-bs-target="#questionModal" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-zadat_vopros');"
                    >Задать вопрос</a>
                    <a
                        class="askona-button askona-design-usage-about__cooperation"
                        href="/auth/login" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-nachat_sotrudnichestvo');"
                    >Начать сотрудничество</a>
                </div>
            </div>
        </div>

        <div class="askona-design-start askona-design__start">
            <div class="h1">Легко начать</div>
            <ol class="askona-design-start-steps askona-design-start__steps">
                <li class="askona-design-card askona-design-start-steps__step">
                    <p class="askona-design-card__index">1</p>
                    <p class="askona-design-card__title">
                        Регистрация
                    </p>
                    <p class="askona-design-card__text">
                        <a class="askona-link" href="/auth/login" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-zaregistrirovatsya');">Зарегистрируйтесь</a> в личном кабинете, заполнив простую форму
                    </p>
                </li>
                <li class="askona-design-card askona-design-start-steps__step">
                    <p class="askona-design-card__index">2</p>
                    <p class="askona-design-card__title">
                        Договор
                    </p>
                    <p class="askona-design-card__text">
                        Отправьте документы для заключения договора. С вами свяжется наш менеджер
                    </p>
                </li>
                <li class="askona-design-card askona-design-start-steps__step">
                    <p class="askona-design-card__index">3</p>
                    <p class="askona-design-card__title">
                        Активация
                    </p>
                    <p class="askona-design-card__text">
                        Ваш личный кабинет доступен. Заполните портфолио для продвижения на платформе
                    </p>
                </li>
            </ol>
        </div>

        <div class="askona-design-registration askona-design__registration">
            <div class="askona-design-registration__container">
                <div class="askona-design-registration-content askona-design-registration__content">
                    <p class="askona-design-registration-content__appeal">
                        Зарегистрируйтесь, чтобы стать нашим партнером
                    </p>
                    <a
                        class="askona-button askona-design-registration-content__button"
                        href="/auth/login" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-zaregistrirovatsya');"
                    >Зарегистрироваться</a>
                </div>
            </div>
        </div>

        <div class="banner_to_konkurs">
            <a href="/landing/konkurs" target="_blank">
                <img src="/build/images/landing/konkurs/banner/banner1.jpg" alt="Конкурс Askona">
            </a>
        </div>

        <div class="askona-design-appeal askona-design__appeal">
            <img class="askona-design-appeal__photo" src="/build/images/landing/askona_design/appeal.jpg">
            <div class="askona-design-appeal-content askona-design-appeal__content">
                <div class="mask-icon askona-design-appeal-content__quote"></div>
                <p class="askona-design-appeal-content__text">
                    Будем рады вас видеть среди наших партнеров и&nbsp;со&nbsp;всей ответственностью примем участие в&nbsp;ваших проектах!
                </p>
                <p class="askona-design-appeal-content__author">
                    С уважением, Овчарова Мария<br>
                    Руководитель направления по работе с дизайнерами
                </p>
            </div>
            <div class="askona-design-appeal-questions askona-design-appeal__questions">
                <p class="askona-design-appeal-questions__contact-us">
                    Если у вас остались вопросы, напишите нам
                </p>
                <a
                    class="askona-button askona-design-appeal-questions__question"
                    data-bs-toggle="modal" data-bs-target="#questionModal" onclick="ym(1383371, 'reachGoal', 'lkd.askona.ru-click_button-zadat_vopros');"
                >
                    Задать вопрос
                </a>
            </div>
        </div>
    </main>

    {% include '/landing/common/footer.twig' %}
    {% include '/landing/common/modal.twig' %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript" >
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

        ym(1383371, "init", {
