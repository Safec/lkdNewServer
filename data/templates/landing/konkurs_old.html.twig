{% extends '_layout.html.twig' %}

{% block title %}Конкурс для дизайнеров интерьеров Идеальная комната Askona{% endblock %}
{% block description %}Прими участие в конкурсе дизайнеров интерьеров от Askona и получи призы!{% endblock %}

{% block landCss %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
    <main class="konkurs">
        <div class="konkurs-intro">
            <div class="konkurs-intro-header konkurs-intro__header">
                <a href="https://www.askona.ru/">
                    <img class="konkurs-intro-header__logo" src="/build/images/logo-light.svg" alt="Askona">
                </a>
                <div class="konkurs-intro-header-contacts konkurs-intro-header__contacts">
                    <a class="konkurs-intro-header-contacts__phone" href="tel:88002004090">8 800 200-40-90</a>
                    <a
                            class="konkurs-intro-header-contacts__recall" style="cursor: pointer"
                            data-bs-toggle="modal" data-bs-target="#questionModal"
                    >Задать вопрос</a>
                </div>
                <div>
                    <a class="askona-button konkurs-intro-header__cooperation" href="#projectModal">
                        Участвовать
                    </a>
                </div>
            </div>
            <div class="konkurs-intro__contentblock">
                <div class="konkurs-intro__content">
                    <p class="konkurs-intro__description">
                        Конкурс для дизайнеров интерьеров
                    </p>
                    <h1 class="konkurs-intro__title">
                        Идеальная комната
                    </h1>
                    <a class="askona-button konkurs-intro__cooperation" href="#projectModal">
                        Участвовать
                    </a>
                </div>
                <div class="konkurs__opisanie_desktop">
                    <div class="block1">
                        Приглашаем на конкурс дизайн-проектов Askona, где в фокусе - комфорт и стиль. Представьте жилые интерьеры с товарами Askona и Askona Home в главных ролях.
                    </div>
                    <div class="block2">
                        Экспертное жюри оценит гармонию, эстетику и функциональность пространства, созданного в философии здорового сна и уюта. Победители получат ценные призы.
                    </div>
                </div>
            </div>
        </div>

        <div class="konkurs__opisanie_mobile">
            <div class="block1">
                Приглашаем на конкурс дизайн-проектов Askona, где в фокусе - комфорт и стиль. Представьте жилые интерьеры с товарами Askona и Askona Home в главных ролях.
            </div>
            <div class="block2">
                Экспертное жюри оценит гармонию, эстетику и функциональность пространства, созданного в философии здорового сна и уюта. Победители получат ценные призы.
            </div>
            <div>
                <a class="askona-button konkurs__opisanie_mobile__cooperation" href="#projectModal">
                    Участвовать
                </a>
            </div>
        </div>

        <div class="konkurs__nominations">
            <div class="konkurs-nominations-header">
                <div class="konkurs-nominations-header__text">
                    <h2 class="h1">Номинации</h2>
                </div>
                <div class="konkurs-nominations-header__text2">
                    <p>
                        В конкурсе участвуют уже реализованные проекты
                        в 3D-визуализации. Победу определяет независимое
                        жюри — товары Askona Home.
                    </p>
                </div>
            </div>

            <ol class="konkurs-nominations">
                <li class="konkurs-nominations__item">
                    <img src="/build/images/landing/konkurs/nominations/bedroom.png" alt="">
                    <p class="konkurs-nominations__title">Спальня</p>
                </li>

                <li class="konkurs-nominations__item">
                    <img src="/build/images/landing/konkurs/nominations/living.png" alt="">
                    <p class="konkurs-nominations__title">Гостиная</p>
                </li>

                <li class="konkurs-nominations__item">
                    <img src="/build/images/landing/konkurs/nominations/kids.png" alt="">
                    <p class="konkurs-nominations__title">Детская<br>Подростковая</p>
                </li>
            </ol>
        </div>

        <div class="konkurs__juri">
            <div class="konkurs-nominations-header">
                <div class="konkurs-nominations-header__text">
                    <h2 class="h1">Жюри</h2>
                </div>
            </div>
            <div class="konkurs-juri">
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/1.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Елена Корчагова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Коммерческий директор<br>Askona
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/2.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Евгения Белова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Директор категории<br>Диваны и Гостиные Askona
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/3.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Екатерина Гришина
                    </p>
                    <p class="konkurs-juri-card__text">
                        Директор категории<br>Детские товары Askona
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/4.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Татьяна Сугакова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Директор категории<br>спальни Askona
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/5.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Мария Овчарова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Руководитель<br>направления по работе<br>с дизайнерами Askona
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/6.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Полина Камалова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Руководитель<br>отдела локального<br>маркетинга Askona
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/7.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Лариса Бочарова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Главный редактор журнала<br>ГАЛЕРЕЯ ИНТЕРЬЕРОВ
                    </p>
                </div>
                <div class="konkurs-juri-card">
                    <div class="konkurs-juri-card__image">
                        <img src="/build/images/landing/konkurs/juri/8.png" alt="">
                    </div>
                    <p class="konkurs-juri-card__title">
                        Светлана Котлукова
                    </p>
                    <p class="konkurs-juri-card__text">
                        Основатель агентства<br>«Архдиалог»
                    </p>
                </div>
            </div>
        </div>

        <div class="konkurs-timing konkurs__timing">
            <div class="h1">Тайминг</div>
            <div class="konkurs__timing-stages konkurs__timing__stages">
                <div class="konkurs__timing__stages__card">
                    <div class="konkurs__timing__stages__card__timetext">
                        10 февраля – 10 апреля
                    </div>
                    <p class="konkurs__timing__stages__card__title">
                        Подача заявок<br>на сайте
                    </p>
                </div>
                <div class="konkurs__timing__stages__card">
                    <div class="konkurs__timing__stages__card__timetext">
                        10 – 15 апреля
                    </div>
                    <p class="konkurs__timing__stages__card__title">
                        Выбор победителей<br>и голосование
                    </p>
                </div>
                <div class="konkurs__timing__stages__card">
                    <div class="konkurs__timing__stages__card__timetext">
                        20 апреля
                    </div>
                    <p class="konkurs__timing__stages__card__title">
                        Подведение итогов и<br>объявление<br>победителей
                    </p>
                </div>
            </div>
        </div>

        <div class="konkurs-support konkurs__support">
            <div class="konkurs__support__container">
                <div class="konkurs__support__container-header">
                    <div class="konkurs__support__container-header__text">
                        <div class="h1">Призовой фонд</div>
                    </div>
                    <div class="konkurs__support__container-header__text2">
                        <p>
                            3 победителя<br>в каждой номинации
                        </p>
                    </div>
                </div>

                <div class="konkurs-support-stages konkurs-support__stages">
                    <div class="konkurs-card">
                        <div class="mask-icon konkurs-card__icon konkurs-card__icon--discount"></div>
                        <p class="konkurs-card__title">
                            Призы
                        </p>
                        <p class="konkurs-card__text">
                            от компании Askona: подарочные сертификаты, подушки, массажеры
                        </p>
                    </div>
                    <div class="konkurs-card">
                        <div class="mask-icon konkurs-card__icon konkurs-card__icon--manager"></div>
                        <p class="konkurs-card__title">
                            Купон
                        </p>
                        <p class="konkurs-card__text">
                            на повышенный бонус в <a href="https://lkd.askona.ru/admin/designers" target="_blank">программе лояльности</a> дизайнеров на +5% на 3 месяца
                        </p>
                    </div>
                    <div class="konkurs-card">
                        <div class="mask-icon konkurs-card__icon konkurs-card__icon--assortment"></div>
                        <p class="konkurs-card__title">
                            Публикация
                        </p>
                        <p class="konkurs-card__text">
                            работ в социальных сетях Askona в Бренд Медиа Sleep Club
                        </p>
                    </div>
                    <div class="konkurs-card">
                        <div class="mask-icon konkurs-card__icon konkurs-card__icon--sales"></div>
                        <p class="konkurs-card__title">
                            Дипломы
                        </p>
                        <p class="konkurs-card__text">
                            победителей и призеров в электронном формате
                        </p>
                    </div>
                </div>
            </div>
        </div>



        <div class="konkurs-usage konkurs__usage">
            <div class="h1">Как принять участие</div>

            <div class="konkurs-usage-about konkurs-usage__about">
                <ol class="konkurs-usage-stages konkurs-usage-about__stages">

                    <li class="konkurs-usage-stages__stage">
                        <div class="konkurs-usage-stage-grid">
                            <div class="konkurs-usage-stage konkurs-usage-stage-wrapper__content">
                                <p class="konkurs-usage-stage__title">Создайте или реализуйте<br>проект комнаты</p>
                                <div class="konkurs-usage-stage__text">с товарами Askona и Askona Home</div>
                            </div>

                            <img class="konkurs-usage-stage-wrapper__ui" src="/build/images/landing/konkurs/ui-1.png">
                        </div>
                    </li>

                    <li class="konkurs-usage-stages__stage">
                        <div class="konkurs-usage-stage-grid">
                            <div class="konkurs-usage-stage konkurs-usage-stage-wrapper__content">
                                <p class="konkurs-usage-stage__title">Подготовьте не менее<br>5 качественных фото<br>или 3D-визуализаций</p>
                            </div>

                            <img class="konkurs-usage-stage-wrapper__ui" src="/build/images/landing/konkurs/ui-2.png">
                        </div>
                    </li>

                    <li class="konkurs-usage-stages__stage">
                        <div class="konkurs-usage-stage-grid">
                            <div class="konkurs-usage-stage konkurs-usage-stage-wrapper__content">
                                <p class="konkurs-usage-stage__title">Отправьте заявку на почту<br><a href="mailTo:askona_design@askona.ru">askona_design@askona.ru</a><br>до 10 апреля 2026 года</p>
                                <div class="konkurs-usage-stage__text">с темой: Работы на конкурс «Идеальная комната»<br>или заполните форму на этой странице и приложите<br>ссылку на проект в облаке</div>
                            </div>

                            <img class="konkurs-usage-stage-wrapper__ui" src="/build/images/landing/konkurs/ui-3.png">
                        </div>
                    </li>

                </ol>
            </div>
        </div>
    </main>


    {% include '/landing/common/footerKonkurs.twig' %}
    {% include '/landing/common/modal.twig' %}

{% endblock %}

